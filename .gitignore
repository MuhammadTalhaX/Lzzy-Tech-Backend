```gitignore
# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# Testing
coverage/

# IDE and editor
.vscode/*
!.vscode/extensions.json
.idea/

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp

# Local database and tool files
*.db
*.sqlite
*.sqlite3

# Prisma local files
prisma/*.db
```