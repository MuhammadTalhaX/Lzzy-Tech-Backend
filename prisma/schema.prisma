
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderPaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum SaleStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  REFUNDED
}

model Product {
  id              String   @id @default(cuid())
  name            String   @db.VarChar(200)
  sku             String   @unique @db.VarChar(100)
  slug            String   @unique @db.VarChar(220)
  category        String   @db.VarChar(100)
  brand           String   @db.VarChar(100)
  price           Decimal  @db.Decimal(12, 2)
  discountedPrice Decimal? @db.Decimal(12, 2)
  description     String   @db.Text
  seoTitle        String?  @db.VarChar(200)
  metaDescription String?  @db.VarChar(320)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?

  images         ProductImage[]
  specifications ProductSpecification[]
  orderItems     OrderItem[]

  @@index([category])
  @@index([brand])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String   @db.Text
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  key       String  @db.VarChar(100)
  value     String  @db.VarChar(500)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Admin {
  id           String    @id @default(cuid())
  adminId      String    @unique @db.VarChar(50)
  passwordHash String    @db.VarChar(255)
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Order {
  id                  String             @id @default(cuid())
  orderNumber         String             @unique @db.VarChar(30)

  customerName        String             @db.VarChar(200)
  contactNumber       String             @db.VarChar(30)
  deliveryAddress     String             @db.Text
  city                String             @db.VarChar(100)
  deliveryNotes       String?            @db.Text

  status              OrderStatus        @default(PENDING_PAYMENT)
  paymentStatus       OrderPaymentStatus @default(PENDING)
  paymentTransactionRef String?          @db.VarChar(150)
  paymentProofUrl     String?            @db.Text
  paymentAdminNote    String?            @db.Text
  paymentSubmittedAt  DateTime?
  paymentVerifiedAt   DateTime?

  currency            String             @default("PKR") @db.VarChar(3)
  subtotal            Decimal            @db.Decimal(12, 2)
  discountTotal       Decimal            @default(0) @db.Decimal(12, 2)
  deliveryCharge      Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal            @db.Decimal(12, 2)

  customerConfirmedAt DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?            @db.Text

  items               OrderItem[]
  sale                Sale?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([contactNumber])
  @@index([createdAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String?

  productName     String   @db.VarChar(200)
  productSku      String   @db.VarChar(100)
  productSlug     String   @db.VarChar(220)

  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  unitDiscount    Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal  @db.Decimal(12, 2)

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Sale {
  id                 String     @id @default(cuid())
  saleNumber         String     @unique @db.VarChar(30)
  orderId            String     @unique

  status             SaleStatus @default(CONFIRMED)
  currency           String     @default("PKR") @db.VarChar(3)

  subtotal           Decimal    @db.Decimal(12, 2)
  discountTotal      Decimal    @default(0) @db.Decimal(12, 2)
  deliveryCharge     Decimal    @default(0) @db.Decimal(12, 2)
  totalRevenue       Decimal    @db.Decimal(12, 2)

  supplierCostTotal  Decimal    @default(0) @db.Decimal(12, 2)
  actualDeliveryCost Decimal    @default(0) @db.Decimal(12, 2)
  otherCosts         Decimal    @default(0) @db.Decimal(12, 2)
  grossProfit        Decimal    @db.Decimal(12, 2)

  createdByAdminId   String?
  notes              String?    @db.Text
  confirmedAt        DateTime   @default(now())
  completedAt        DateTime?
  cancelledAt        DateTime?

  order              Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items              SaleItem[]

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

model SaleItem {
  id                String   @id @default(cuid())
  saleId            String

  productId         String?
  productName       String   @db.VarChar(200)
  productSku        String   @db.VarChar(100)

  quantity          Int
  unitSellingPrice  Decimal  @db.Decimal(12, 2)
  unitSupplierCost  Decimal  @db.Decimal(12, 2)
  lineRevenue       Decimal  @db.Decimal(12, 2)
  lineSupplierCost  Decimal  @db.Decimal(12, 2)
  lineGrossProfit   Decimal  @db.Decimal(12, 2)

  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  createdAt         DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

model OrderCounter {
  id    Int @id @default(1)
  value Int @default(0)
}